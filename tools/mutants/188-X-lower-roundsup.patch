diff --git a/src/mag/convert.rs b/src/mag/convert.rs
index 019043e..f6696b5 100644
--- a/src/mag/convert.rs
+++ b/src/mag/convert.rs
@@ -102,7 +102,7 @@ impl Mag {
     /// Greatest `Mag` at or below `|x|` (CONTRACT 3.4). NaN and ±Inf give zero; zero gives zero.
     pub fn from_exact_num_lower(x: &ExactNum) -> Mag {
         match top_of(x) {
-            Top::Finite { mant, exp, .. } => Mag::from_canonical(exp, mant),
+            Top::Finite { mant, sticky, exp } => Mag::from_canonical(exp, mant.checked_add(u64::from(sticky)).unwrap_or(mant)),
             Top::NotFinite | Top::Zero | Top::Underflow => Mag::zero(),
         }
     }
